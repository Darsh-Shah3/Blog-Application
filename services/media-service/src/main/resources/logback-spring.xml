<?xml version="1.0" encoding="UTF-8"?>
<!-- Format: timestamp LEVEL [service] [api=METHOD path] [Class.method] [user|id] [req] - message -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="media-service"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [service=${appName}] [api=%X{httpMethod:-} %X{api:-}] [%logger{36}.%method] [user=%X{username:--}|id=%X{userId:--}] [req=%X{requestId:--}] - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
    <logger name="com.threadly" level="DEBUG"/>
</configuration>
