# PostgreSQL
POSTGRES_USER=threadly
POSTGRES_PASSWORD=threadly_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@threadly.local
PGADMIN_PASSWORD=admin_secret

# JWT HS256 secret (min 32 chars / 256-bit). Rotate in production.
JWT_SECRET=ThR3@dly-Jwt-Hs256-Secret-Key-2026-Industry-Grade-9f3c8a2b7e1d
JWT_EXPIRATION_MS=86400000
REQUIRE_JWT_FOR_ALL_APIS=true

# Internal service-to-service key (never expose via gateway)
INTERNAL_API_KEY=threadly-internal-svc-key-9f3c8a2b

# Rate limiting (gateway + each service)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_AUTH_RPM=20

# Service ports (host mapping)
GATEWAY_PORT=8080
AUTH_PORT=8081
COMMUNITY_PORT=8082
POST_PORT=8083
COMMENT_PORT=8084
VOTE_PORT=8085
MEDIA_PORT=8086
AUDIT_PORT=8087
NOTIFICATION_PORT=8088
FRONTEND_PORT=3000
PGADMIN_PORT=5050
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Bootstrap platform admin (created once if username/email free)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@threadly.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# Media (free local volume — see docs/media-storage.md)
MEDIA_MAX_MULTIPART=50MB
MEDIA_MAX_FILE_BYTES=52428800
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
MEDIA_MAX_AUDIO_BYTES=15728640
MEDIA_MAX_DOCUMENT_BYTES=20971520
MEDIA_MAX_OTHER_BYTES=10485760

# Password reset SMTP (set MAIL_ENABLED=true + host to actually send mail)
# Free options: Gmail app password, Outlook, or Mailtrap sandbox
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@threadly.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
FRONTEND_BASE_URL=http://localhost:3000
MAIL_RESET_TOKEN_MINUTES=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
