# =============================================================================
# Threadly — environment template (safe to commit)
# =============================================================================
# Copy to .env and fill in real secrets. Never commit .env.
#
#   cp .env.example .env
#
# Placeholders like CHANGE_ME are intentionally not real credentials.
# Production / public deploy: use strong unique secrets and your public URLs.
#
# Prod-like Compose (SPRING_PROFILES_ACTIVE=prod, host ports = frontend+gateway only):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Requires Docker Compose ≥ 2.24. See docs/security.md and docs/deploy.md.
# =============================================================================

# --- PostgreSQL (shared by all services in docker-compose) ---
POSTGRES_USER=threadly
# Prod-like / public: replace with a strong unique password (never the sample default).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port mapping (Windows often uses 5433 to avoid local Postgres conflict)
POSTGRES_HOST_PORT=5433

# --- pgAdmin (optional UI; do not expose publicly in production) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# --- JWT (HS256: use a long random string, min ~32 chars) ---
# Prod-like / public: must be a strong unique secret shared by gateway + all services.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000
REQUIRE_JWT_FOR_ALL_APIS=true

# --- Inter-service auth (never send to browsers; not a JWT) ---
# Prod-like / public: strong unique value; stripped at the gateway for browser traffic.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

# --- CORS (api-gateway CorsConfig + community WebSocket) ---
# Comma-separated origins. Local defaults match frontend. Deploy: set your real origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Shared Redis counters (recommended with multiple gateway replicas). Compose defaults true.
RATE_LIMIT_REDIS_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_AUTH_RPM=20

# --- Redis (rate limits, JWT blacklist, hot-read caches; password required by Compose) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_HOST_PORT=6379
# Master switch for Redis beans in gateway + auth/post/community/notification
REDIS_ENABLED=true
# JWT logout / revoke-all (gateway + STOMP check; auth writes keys)
TOKEN_BLACKLIST_ENABLED=true
# Feed / community / profile / unread-count caches
CACHE_REDIS_ENABLED=true

# --- Published host ports (local docker-compose) ---
GATEWAY_PORT=8080
AUTH_PORT=8081
COMMUNITY_PORT=8082
POST_PORT=8083
COMMENT_PORT=8084
VOTE_PORT=8085
MEDIA_PORT=8086
AUDIT_PORT=8087
NOTIFICATION_PORT=8088
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Grafana (change password before public access) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Bootstrap platform admin (created once if username/email free) ---
# Local debug: true is fine for first boot. Prod-like Compose forces false.
# Empty auth DB on a server: set true once to create the admin, then set false and restart.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin

# --- Media upload limits (see docs/media-storage.md) ---
MEDIA_MAX_MULTIPART=50MB
MEDIA_MAX_FILE_BYTES=52428800
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=52428800
MEDIA_MAX_AUDIO_BYTES=15728640
MEDIA_MAX_DOCUMENT_BYTES=20971520
MEDIA_MAX_OTHER_BYTES=10485760
# Storage backend: local (Docker volume) or s3 (MinIO / R2 / AWS)
MEDIA_STORAGE=local
# When MEDIA_STORAGE=s3, also start MinIO: docker compose --profile minio up -d
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=threadly-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Frontend / public URLs ---
# Local: keep localhost. Deploy: use http(s)://YOUR_IP_OR_DOMAIN (no trailing slash).
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090

# --- Google OAuth (optional; leave empty for email-only auth) ---
# Console: APIs & Services → Credentials → OAuth 2.0 Web client
# Authorized JavaScript origin:  {OAUTH_REDIRECT_BASE_URL}
# Authorized redirect URI:       {OAUTH_REDIRECT_BASE_URL}/oauth/callback/google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# --- Google reCAPTCHA v2 (signup antispam; leave empty to disable locally) ---
# Console: https://www.google.com/recaptcha/admin → Create (reCAPTCHA v2 "I'm not a robot")
# Domains: localhost + your public host/IP. Site key is public; secret stays on the server only.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Password-reset SMTP (optional) ---
# Enable only with a real host + credentials. Never put real app passwords in this file.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_RESET_TOKEN_MINUTES=30
